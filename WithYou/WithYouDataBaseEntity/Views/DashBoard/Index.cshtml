@using WithYouDataBaseEntity.ModelView
@model DashboardViewModel;

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="fontawesome-free-6.7.2-web/css/all.css">
    <!-- <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet"> -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="" href="dashboard.css">


    <title>Dashboard | Home</title>

</head>

<body>
    <div class="container">

        <aside>

            <div class="top">

                <div class="log">
                    <img src="" alt="logo">
                    <h2>With <span class="danger">You</span></h2>
                </div>
                <div class="close" id="close-btn">
                    <span class="material-icons">
                        close
                    </span>
                </div>
            </div>
            <div class="sidebar">
                <a href=" @Url.Action("Index", "Dashboard")">
                    <h3>لوحة تحكم</h3>
                    <span class="material-icons">
                        grid_view
                    </span>

                </a>
                <a href="@Url.Action("Specialests","Specialest")">
                    <h3>الأخصائيين </h3>

                    <span class="material-icons">psychology</span>
                </a>
                <a href="@Url.Action("User","User")" class="active">
                    <h3>المستخدمين </h3>
                    <span class="material-icons">person</span>

                </a>
                <a href=" @Url.Action("Seesions", "Session")">
                    <h3>المقابلات </h3>
                    <span class="material-icons">duo</span>

                </a>
                <a href="@Url.Action("Payments","Payment")">
                    <h3>المدفوعات </h3>
                    <span class="material-icons">credit_card</span>

                </a>
                <a href=" @Url.Action("Messeges", "Messege")">
                    <h3>الرسائل </h3>
                    <span class="material-icons">mail</span>

                </a>
               
                <a href="@Url.Action("Reviews","Review")">
                    <h3>المراجعات </h3>
                    <span class="material-icons">mail</span>
                    <!-- <span class="messege-count">10</span> -->
                </a>
                <a href="@Url.Action("Articels","Articel")">
                    <h3>الشهادات </h3>
                    <span class="material-icons">article</span>

                </a>
                <a href="@Url.Action("Settings","Setting")">
                    <h3>الإعدادات</h3>
                    <span class="material-icons">settings</span>

                </a>
                <a href="@Url.Action("Login","Account")">
                    <h3>الخروج</h3>
                    <span class="material-icons">logout</span>

                </a>
            </div>
        </aside>

        <!-- main -->

        <main>
            <button id="menu-btn">
                <span class="material-icons">
                    menu
                </span>
            </button>
            <h1>لوحة تحكم</h1>
            <div class="date">
                <input type="date">
            </div>
            <div class="insitghts">
                <!-- --------------Start of Sales----------------- -->
                <div class="sales">
                    <span class="material-icons">
                        analytics
                    </span>
                    <div class="middle">
                        <div class="left">
                            <h3>إجمالي المستخدمين المسجلين</h3>
                            <h1>@ViewBag.numberofuser</h1>

                        </div>
                        <div class="progress">
                            <svg>
                                <circle cx='38' cy='38' r='36'></circle>
                            </svg>
                            <div class="number">
                                <p>81%</p>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">آخر 24 ساعة</small>
                </div>
                <!-- --------------End of Sales----------------- -->
                <!-- --------------Start of Expensc----------------- -->
                <div class="Expenses">
                    <span class="material-icons">
                        bar_chart
                    </span>
                    <div class="middle">
                        <div class="left">
                            <h3>عدد الجلسات المحجوزة</h3>
                            <h1>@ViewBag.bookedsession</h1>

                        </div>
                        <div class="progress">
                            <svg>
                                <circle cx='38' cy='38' r='36'></circle>
                            </svg>
                            <div class="number">
                                <p>49%</p>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">آخر 24 ساعة</small>
                </div>
                <!-- --------------End of Expensc----------------- -->
                <!-- --------------Start of Income----------------- -->
                <div class="Income">
                    <span class="material-icons">
                        stacked_line_chart
                    </span>
                    <div class="middle">
                        <div class="left">
                            <h3>إجمالي المدفوعات</h3>
                            <h1>$@ViewBag.sumpayments</h1>

                        </div>
                        <div class="progress">
                            <svg>
                                <circle cx='38' cy='38' r='36'></circle>
                            </svg>
                            <div class="number">
                                <p>52%</p>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">آخر 24 ساعة</small>
                </div>
                <!-- --------------End of Income----------------- -->
            </div>
            <!-- -----------------------End OF Insight ----------------------->

            <div class="recent-order">
                <h2>آخر الخدمات</h2>
                <table>
                    <thead>
                        <tr>
                            <th>اسم الجلسة</th>
                            <th>رقم الجلسة</th>
                            <th>طبيب الجلسة</th>
                            <th>الدفع</th>
                            <th>حالة الجلسة</th>
                            <th>التفاصيل</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if(Model == null)
                        {
                        <tr>
                            <td colspan="6" class="text-center">لا توجد بيانات لعرضها</td>
                        </tr>
                        }
                        else
                        {
                            foreach (var item in Model.RecentSessions)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.ID</td>
                                    <td>@item.Payment</td>
                                    <td class="success">@item.Stute</td>
                                    <td><a href="@Url.Action("Details", "Session", new { id = item.ID })">المزيد</a></td>
                                </tr>
                            }
                        }
                        
                    </tbody>
                </table>
                <a href="@Url.Action("AllSessions", "Session")">عرض المزيد</a>
            </div>
        </main>

        <!-- end main -->

        <div class="right">
            <div class="top">

                <div class="theme-toggler">
                    <span class="material-icons active">
                        light_mode
                    </span>
                    <span class="material-icons">
                        dark_mode
                    </span>
                </div>
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b>@TempData["AdminName"]</b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo">
                        <img src="/images/man3.png" alt="image">
                    </div>
                </div>
            </div>
            <div class="recent-updates">
                <h2>Recent Update</h2>
                <div class="updates">
                    <div class="update">
                        <div class="profile-photo">
                            <img src="" alt="">
                        </div>
                        <div class="messege">
                            <p> <b>محمد</b> قام بحجز جلسة مع الطبيب أحمد </p>
                            <small class="text-muted">منذ 2 من الدقائق</small>
                        </div>
                    </div>
                    <div class="update">
                        <div class="profile-photo">
                            <img src="" alt="">
                        </div>
                        <div class="messege">
                            <p> <b>سارة</b> كتبت مراجعة عن الطبيب خالد. </p>
                            <small class="text-muted">منذ 2 من الدقائق</small>
                        </div>
                    </div>
                    <div class="update">
                        <div class="profile-photo">
                            <img src="" alt="">
                        </div>
                        <div class="messege">
                            <p> <b>سارة</b> كتبت مراجعة عن الطبيب خالد. </p>
                            <small class="text-muted">منذ 2 من الدقائق</small>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ----------------------End Recent Updates -->
            <!-- ----------------------Start Sales Analystic Updates -->

            <div class="sales-analytics">
                <h2>Sales Analytics</h2>
                <div class="item Online">
                    <div class="icon">
                        <span class="material-icons">
                            shopping_cart
                        </span>
                    </div>
                    <div class="right">
                        <div class="info">
                            <h3>الجلسات المكتملة</h3>
                            <small class="text-muted">آخر 24 ساعة</small>
                        </div>
                        <h5 class="success">+39%</h5>
                        <h3>@ViewBag.unablesession</h3>
                    </div>
                </div>
                <div class="item Offline">
                    <div class="icon">
                        <span class="material-icons">
                            local_mall
                        </span>
                    </div>
                    <div class="right">
                        <div class="info">
                            <h3>الجلسات الملغاة</h3>
                            <small class="text-muted">آخر 24 ساعة</small>
                        </div>
                        <h5 class="danger">-17%</h5>
                        <h3>@ViewBag.canceledsession</h3>
                    </div>
                </div>
                <div class="item customer">
                    <div class="icon">
                        <span class="material-icons">
                            person
                        </span>
                    </div>
                    <div class="right">
                        <div class="info">
                            <h3>المستخدمون الجدد</h3>
                            <small class="text-muted">آخر 24 ساعة</small>
                        </div>
                        <h5 class="success">+25%</h5>
                        <h3>@ViewBag.lastusersinday</h3>
                    </div>
                </div>

                <div class="item add-product">
                    <span class="material-icons">
                        add
                    </span>
                    <h3>
                        إضافة مقال جديد
                    </h3>
                </div>
            </div>

        </div>
    </div>

    <script src="dashboard.js"></script>
</body>

</html>